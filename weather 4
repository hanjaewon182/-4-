import requests
import time
from datetime import datetime, timedelta
from typing import Optional
import json


GEOCODE_URL = "https://geocoding-api.open-meteo.com/v1/search"
FORECAST_URL = "https://api.open-meteo.com/v1/forecast"


def request_with_retry(url: str, params: dict, retries: int = 3, delay: float = 2.0) -> Optional[dict]:
    """네트워크 오류 발생 시 지정한 횟수만큼 재시도하며 요청을 보낸다."""
    last_error = None
    for attempt in range(1, retries + 1):
        try:
            res = requests.get(url, params=params, timeout=10)
            res.raise_for_status()
            return res.json()
        except requests.RequestException as e:
            last_error = e
            if attempt < retries:
                print(f"⚠️ 요청 실패 (시도 {attempt}/{retries}), {delay}초 후 재시도합니다...")
                time.sleep(delay)
    print(f"❌ {retries}번 재시도했지만 요청에 실패했습니다: {last_error}")
    return None

