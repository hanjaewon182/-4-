def get_weather_desc(code: int):
    """weathercode를 (설명, 이모지)로 변환. 목록에 없으면 기본값 반환."""
    return WEATHER_CODE_MAP.get(code, ("정보 없음", "❔"))

def _request_geocode(query: str) -> Optional[dict]:
    """Open-Meteo Geocoding API에 실제로 요청을 보내는 내부 함수."""
    params = {
        "name": query,
        "count": 1,
        "language": "ko",
        "format": "json",
    }
    try:
        res = requests.get(GEOCODE_URL, params=params, timeout=10)
        res.raise_for_status()
        data = res.json()
    except requests.RequestException as e:
        print(f"⚠️ 지역 검색 중 오류가 발생했습니다: {e}")
        return None

    results = data.get("results")
    if not results:
        return None

    first = results[0]
    return {
        "name": first.get("name", query),
        "latitude": first["latitude"],
        "longitude": first["longitude"],
    }


def get_coordinates(city_name: str) -> Optional[dict]:
    """지역명을 위경도로 변환 (Open-Meteo Geocoding API 사용).

    한글 지역명은 매핑 테이블로 먼저 영문 변환을 시도하고,
    실패하면 입력값 그대로 다시 한번 검색한다.
    """
    mapped_name = KOREAN_CITY_MAP.get(city_name.strip())
    if mapped_name:
        result = _request_geocode(mapped_name)
        if result:
            return result

    return _request_geocode(city_name)

def fetch_weather(latitude: float, longitude: float, days: int) -> Optional[dict]:
    """지정한 위경도의 시간별 날씨 데이터를 가져온다 (실패 시 자동 재시도)."""
    params = {
        "latitude": latitude,
        "longitude": longitude,
        "hourly": "temperature_2m,precipitation_probability,relative_humidity_2m,"
                  "weathercode,windspeed_10m",
        "daily": "temperature_2m_max,temperature_2m_min",
        "timezone": "auto",
        "forecast_days": days,
    }
    return request_with_retry(FORECAST_URL, params)


def pick_hour_value(hourly: dict, target_date: str, target_hour: str):
    """hourly 데이터에서 특정 날짜(target_date)와 시각(target_hour, 'HH:00')에 해당하는 값을 찾는다."""
    times = hourly["time"]
    target_iso = f"{target_date}T{target_hour}"
    if target_iso not in times:
        return None
    idx = times.index(target_iso)
    return {
        "temp": hourly["temperature_2m"][idx],
        "precip_prob": hourly["precipitation_probability"][idx],
        "humidity": hourly["relative_humidity_2m"][idx],
        "code": hourly["weathercode"][idx],
        "wind": hourly["windspeed_10m"][idx],
    }


def summarize_day(morning: Optional[dict], afternoon: Optional[dict], tmin: float, tmax: float) -> str:
    """하루치 날씨를 한 줄 요약 문장으로 만든다."""
    if not morning and not afternoon:
        return "날씨 정보를 요약할 수 없습니다."

    rain_chance = max(
        (morning or {}).get("precip_prob", 0),
        (afternoon or {}).get("precip_prob", 0),
    )

    if rain_chance >= 60:
        outlook = "비가 올 확률이 높은 날입니다. 우산을 챙기세요."
    elif rain_chance >= 30:
        outlook = "비가 올 수도 있으니 우산을 챙기는 게 좋습니다."
    else:
        outlook = "대체로 맑고 비 걱정은 적은 날입니다."

    return f"오늘은 최저 {tmin}°C, 최고 {tmax}°C가 예상되며, {outlook}"

def label_for_day(offset: int, date_str: str) -> str:
    """오늘/내일/모레 형태의 라벨을 만든다."""
    md = datetime.strptime(date_str, "%Y-%m-%d").strftime("%m.%d.")
    if offset == 0:
        return f"오늘 ({md})"
    elif offset == 1:
        return f"내일 ({md})"
    elif offset == 2:
        return f"모레 ({md})"
    else:
        return f"{offset}일 후 ({md})"


def print_slot(time_label: str, icon_time: str, info: dict):
    desc, icon = get_weather_desc(info["code"])
    print(f"  {icon_time} {time_label}")
    print(f"     날씨: {desc}")
    print(f"     기온: {info['temp']} °C")
    print(f"     강수확률: {info['precip_prob']}%")
    print(f"     습도: {info['humidity']}%")
    print(f"     풍속: {info['wind']} m/s")
    print()


def display_weather(city_name: str, data: dict, days: int):
    hourly = data["hourly"]
    daily = data["daily"]

    print("=" * 60)
    print(f"🌈 {city_name} 날씨 예보 (오전 6시 / 오후 3시 기준)")
    print("=" * 60)

    for offset in range(days):
        date = daily["time"][offset]
        print()
        print(label_for_day(offset, date))
        print("-" * 60)

        morning = pick_hour_value(hourly, date, "06:00")
        afternoon = pick_hour_value(hourly, date, "15:00")

        if morning:
            print_slot("오전 06:00", "🌅", morning)
        if afternoon:
            print_slot("오후 15:00", "🏙️", afternoon)

        tmin = daily["temperature_2m_min"][offset]
        tmax = daily["temperature_2m_max"][offset]
        print(f"  🌡️ 일일 기온: 최저 {tmin} °C / 최고 {tmax} °C")
        print(f"  📝 요약: {summarize_day(morning, afternoon, tmin, tmax)}")
        print()
        print("=" * 60)


def save_to_json(city_name: str, data: dict):
    filename = f"weather_{city_name}_{datetime.now().strftime('%Y%m%d_%H%M%S')}.json"
    try:
        with open(filename, "w", encoding="utf-8") as f:
            json.dump(data, f, ensure_ascii=False, indent=2)
        print(f"✅ '{filename}' 파일로 저장했습니다.")
    except OSError as e:
        print(f"⚠️ 파일 저장 중 오류가 발생했습니다: {e}")


def load_saved_json(filename: str) -> Optional[dict]:
    """이전에 저장해둔 JSON 날씨 파일을 다시 불러온다."""
    try:
        with open(filename, "r", encoding="utf-8") as f:
            data = json.load(f)
        print(f"📂 '{filename}' 파일을 불러왔습니다.")
        return data
    except FileNotFoundError:
        print(f"⚠️ '{filename}' 파일을 찾을 수 없습니다.")
        return None
    except json.JSONDecodeError as e:
        print(f"⚠️ JSON 파일을 읽는 중 오류가 발생했습니다: {e}")
        return None

def main():
    print("🌦️ 날씨 예보 프로그램 (Open-Meteo API)")
    print("-" * 60)
    print("오전 6시, 오후 3시 기준으로 여러 날의 날씨를 제공합니다.")
    print("-" * 60)
    print()

    load_choice = input("이전에 저장한 JSON 파일을 불러오시겠습니까? (y/n): ").strip().lower()
    if load_choice == "y":
        saved_filename = input("불러올 파일명을 입력하세요: ").strip()
        saved_data = load_saved_json(saved_filename)
        if saved_data:
            print("저장된 날씨 데이터를 불러왔습니다. 프로그램을 종료합니다.")
            return
        print("새로 날씨를 조회합니다.")
        print()

    city_input = input("날씨를 확인할 지역을 입력하세요 (기본값: 서울): ").strip()
    city_name = city_input if city_input else "서울"

    days_input = input("몇 일간의 날씨를 보시겠습니까? (기본값: 3, 최대 7): ").strip()
    try:
        days = int(days_input) if days_input else 3
        days = max(2, min(days, 7))  # 2~7일 범위로 제한 (과제 조건: 2일 이상)
    except ValueError:
        days = 3

    print()
    location = get_coordinates(city_name)
    if not location:
        print(f"❌ '{city_name}' 지역을 찾을 수 없습니다. 프로그램을 종료합니다.")
        return

    print(f"📍 {location['name']} (위도: {location['latitude']}, "
          f"경도: {location['longitude']})의 날씨 정보를 가져옵니다...")
    print()

    data = fetch_weather(location["latitude"], location["longitude"], days)
    if not data:
        print("❌ 날씨 정보를 가져오지 못했습니다. 프로그램을 종료합니다.")
        return

    display_weather(location["name"], data, days)

    save_choice = input("날씨 정보를 JSON 파일로 저장하시겠습니까? (y/n): ").strip().lower()
    if save_choice == "y":
        save_to_json(location["name"], data)

    print()
    print("프로그램을 종료합니다. 감사합니다. 👋")


if __name__ == "__main__":
    main()